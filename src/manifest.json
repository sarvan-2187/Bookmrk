{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 3,
  "version": "1.7.0",
  "name": "Bookmrk",
  "description": "Open-source, local-first visual bookmark manager",
  "firefox:browser_specific_settings": {
    "gecko": {
      "id": "bookmrk@local.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/favicon-16x16.png",
    "32": "icons/favicon-32x32.png",
    "192": "icons/android-chrome-192x192.png",
    "512": "icons/android-chrome-512x512.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "permissions": ["storage", "bookmarks", "contextMenus", "tabs", "search"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "quick-save": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Quick Save current tab to Bookmrk"
    }
  },
  "background": {
    "chromium:service_worker": "background.ts",
    "firefox:scripts": ["background.ts"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/scripts.ts"],
      "run_at": "document_idle"
    }
  ]
}
