{
  "private": true,
  "name": "bookmrk",
  "description": "Open-source, local-first visual bookmark manager",
  "version": "1.6.0",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "extension": "^4.1.17",
    "tailwindcss": "^4.1.14",
    "typescript": "7.0.2"
  },
  "scripts": {
    "dev": "extension dev",
    "start": "extension start",
    "build": "extension build",
    "preview": "extension preview",
    "build:chrome": "extension build --browser chrome",
    "build:firefox": "extension build --browser firefox",
    "build:edge": "extension build --browser edge",
    "release": "node scripts/release.mjs",
    "zip:source": "extension build --browser firefox --zip --zip-source --zip-filename bookmrk-source",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.13"
  },
  "packageManager": "npm@11.4.1"
}
